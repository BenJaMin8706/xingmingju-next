# Copy this file to .env.local for local development.
# In Vercel, set these in Project Settings > Environment Variables.

# Required for production persistence (otherwise data is kept in /tmp and lost on restart)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional override for local data dir (defaults to ./.data)
# XINGMINGJU_DATA_DIR=

# AI 大模型 API
AI_API_BASE_URL=https://api.bestmax.cc
AI_API_KEY=
AI_MODEL=deepseek-chat
